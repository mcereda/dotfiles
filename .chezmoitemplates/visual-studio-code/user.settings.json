{{- $vscodeExtensions := output "code" "--list-extensions" | splitList "\n" | compact }}

{{- /*
     * Load base user settings from user.settings.base.json.
     */}}

{{- $vscodeSettings := includeTemplate "visual-studio-code/user.settings.base.json" . | fromJson }}


{{- /*
     * Ignore extensions requiring missing binaries.
     */}}

{{- $ignoredExtensions := list }}

{{- if not (lookPath "ansible") }}
{{-   $ignoredExtensions = append $ignoredExtensions "redhat.ansible" }}
{{- end }}

{{- if not (lookPath "az") }}
{{-   $ignoredExtensions = concat $ignoredExtensions (list
        "ms-azure-devops.azure-pipelines"
        "ms-azuretools.vscode-azureterraform"
        "ms-azuretools.vscode-bicep"
        "ms-vscode.azure-account"
        "ms-vscode.azurecli"
        "msazurermtools.azurerm-vscode-tools"
      ) }}
{{- end }}

{{- if not (lookPath "docker") }}
{{-   $ignoredExtensions = concat $ignoredExtensions (list
        "ms-azuretools.vscode-docker"
        "ms-vscode-remote.remote-containers"
      ) }}
{{- end }}

{{- if not (lookPath "git") }}
{{-   $ignoredExtensions = append $ignoredExtensions "eamodio.gitlens" }}
{{- end }}

{{- if not (lookPath "go") }}
{{-   $ignoredExtensions = concat $ignoredExtensions (list
        "casualjim.gotemplate"
        "golang.go"
      ) }}
{{- end }}

{{- if not (lookPath "gpg") }}
{{-   $ignoredExtensions = append $ignoredExtensions "JHeilingbrunner.vscode-gnupg-tool" }}
{{- end }}

{{- if not (lookPath "kubectl") }}
{{-   $ignoredExtensions = append $ignoredExtensions "ms-kubernetes-tools.vscode-kubernetes-tools" }}
{{- end }}

{{- if not (lookPath "make") }}
{{-   $ignoredExtensions = append $ignoredExtensions "ms-vscode.makefile-tools" }}
{{- end }}

{{- if not (lookPath "pwsh") }}
{{-   $ignoredExtensions = append $ignoredExtensions "ms-vscode.powershell" }}
{{- end }}

{{- if not (lookPath "shellcheck") }}
{{-   $ignoredExtensions = append $ignoredExtensions "timonwong.shellcheck" }}
{{- end }}

{{- if not (or (lookPath "terraform") (lookPath "tofu")) }}
{{-   $ignoredExtensions = append $ignoredExtensions "hashicorp.terraform" }}
{{- end }}


{{- /*
     * Ignore extensions depending on the host's class.
     */}}

{{- $class := dig "class" "private" . }}

{{- if ne $class "work" }}
{{-   $ignoredExtensions = concat $ignoredExtensions (list
        "ms-vsliveshare.vsliveshare"
        "ms-vsliveshare.vsliveshare-audio"
        "ms-vsliveshare.vsliveshare-pack"
      ) }}
{{- end }}

{{- $_ := set $vscodeSettings "settingsSync.ignoredExtensions" $ignoredExtensions }}


{{- /*
     * Extension-specific settings.
     */}}

{{- if and (eq .chezmoi.os "darwin") (stat "/Applications/iTerm.app") }}
{{-   $_ := mustMergeOverwrite $vscodeSettings (dict
        "terminal.external.osxExec" "iTerm.app"
      ) }}
{{- end }}

{{- if has "angelo-breuer.clock" $vscodeExtensions }}
{{-   $_ := mustMergeOverwrite $vscodeSettings (dict
        "clock.alignment" "Right"
        "clock.format"    "yyyy-mm-dd HH:MM"
      ) }}
{{- end }}

{{- if has "streetsidesoftware.code-spell-checker-british-english" $vscodeExtensions }}
{{-   $_ := mustMergeOverwrite $vscodeSettings (dict
        "cSpell.language" "en,en-GB"
      ) }}
{{- end }}

{{- if has "foam.foam-vscode" $vscodeExtensions }}
{{-   $_ := mustMergeOverwrite $vscodeSettings (dict
        "foam.edit.linkReferenceDefinitions" "withExtensions"
      ) }}
{{- end }}

{{- if has "eamodio.gitlens" $vscodeExtensions }}
{{-   $_ := mustMergeOverwrite $vscodeSettings (dict
        "gitlens.codeLens.enabled" false
      ) }}
{{- end }}

{{- if has "rangav.vscode-thunder-client" $vscodeExtensions }}
{{-   $_ := mustMergeOverwrite $vscodeSettings (dict
        "thunder-client.requestLayout"          "Top/Bottom"
        "thunder-client.saveTokenPerEnvironment" true
        "thunder-client.sidebar.defaultTab"     "Collections"
        "thunder-client.sidebar.layout"         "compact"
        "thunder-client.sidebar.treeIndentation" 10
      ) }}
{{- end }}

{{- if has "redhat.ansible" $vscodeExtensions }}
{{-   $_ := mustMergeOverwrite $vscodeSettings (dict
        "ansible.lightspeed.enabled"             false
        "ansible.lightspeed.suggestions.enabled" false
      ) }}
{{- end }}

{{- if has "redhat.vscode-yaml" $vscodeExtensions }}
{{-   $_ := mustMergeOverwrite $vscodeSettings (dict
        "redhat.telemetry.enabled" false
      ) }}
{{- end }}

{{- if has "travisthetechie.write-good-linter" $vscodeExtensions }}
{{-   $_ := mustMergeOverwrite $vscodeSettings (dict
        "write-good.languages" (list "markdown" "plaintext" "yaml")
      ) }}
{{- end }}

{{- if has "yzhang.markdown-all-in-one" $vscodeExtensions }}
{{-   $_ := mustMergeOverwrite $vscodeSettings (dict
        "markdown.extension.italic.indicator"        "_"
        "markdown.extension.orderedList.autoRenumber" false
        "markdown.extension.orderedList.marker"      "one"
        "markdown.extension.toc.levels"              "2..6"
        "markdown.extension.toc.orderedList"          true
      ) }}
{{- end }}


{{- /*
     * Host-specific additions and overrides.
     * --------------------------------------
     * Load configuration overrides from hosts-specific configuration files,
     * should any such file exist.
     * Every file's content will be merged with the default settings, so that
     * settings from the new files will override the ones from previous files.
     */}}

{{- $defaults := dict }}
{{- $_ := set $defaults "data" dict }}
{{- $config := $defaults }}
{{- $configFromFile := include $.chezmoi.configFile | fromYaml }}
{{- $_ := mustMergeOverwrite $config $configFromFile }}

{{- $hostSettingsFiles := list
     (joinPath $config.data.hostDir "Code" "User" "settings.json.tmpl")
     (joinPath $config.data.hostDir "Code" "User" "settings.json") }}

{{- range $f := $hostSettingsFiles }}
{{-   if stat (joinPath $.chezmoi.sourceDir $f) }}
{{-     $override := includeTemplate $f $ | fromJson }}
{{-     $_ := mustMergeOverwrite $vscodeSettings $override }}
{{-   end }}
{{- end }}

{{- $hostEncryptedSettingsFiles := list
     (joinPath $config.data.encryptedHostDir "Code" "User" (print "settings.json.tmpl" (dig "age" "suffix" ".age" $config)))
     (joinPath $config.data.encryptedHostDir "Code" "User" (print "settings.json.tmpl" (dig "gpg" "suffix" ".asc" $config)))
     (joinPath $config.data.encryptedHostDir "Code" "User" (print "settings.json" (dig "age" "suffix" ".age" $config)))
     (joinPath $config.data.encryptedHostDir "Code" "User" (print "settings.json" (dig "gpg" "suffix" ".asc" $config))) }}

{{- range $f := $hostEncryptedSettingsFiles }}
{{-   if stat (joinPath $.chezmoi.sourceDir $f) }}
{{-     if hasKey $config "encryption" }}
{{-       $override := includeTemplate $f $ | decrypt | fromJson }}
{{-       $_ := mustMergeOverwrite $vscodeSettings $override }}
{{-     end }}
{{-   end }}
{{- end }}


{{- /*
     * Write settings down.
     */}}

{{- $vscodeSettings | toPrettyJson -}}
