{{ $shell := coalesce
                (lookPath "fish")
                (lookPath "zsh")
                (lookPath "bash")
                (lookPath "sh") -}}

{
  "$schema": "zed://schemas/settings",

  "cli_default_open_behavior": "new_window",
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "shell": {
      "program": {{ $shell | quote }}
    }
  },

  "inlay_hints": {
    "show_background": true
  },
  "indent_guides": {
    "background_coloring": "indent_aware"
  },
  "project_panel": {
    "dock": "left"
  },
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark"
  }
}
