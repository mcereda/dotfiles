{
    "minimumVersion": "2.1.81",
    "autoUpdatesChannel": "stable",
    
    "tui": "fullscreen",
    "verbose": true,
    "autoDreamEnabled": true,
    "voiceEnabled": true,
    
    "model": "opusplan",
    "alwaysThinkingEnabled": true,
    "effortLevel": "high",
    "outputStyle": "Explanatory",

    "env": {
        "DISABLE_TELEMETRY": "1"
    },
    "enabledPlugins": {
        "skill-creator@claude-plugins-official": true
    },
    "disabledMcpServers": [
        "claude-in-chrome"
    ],

    "permissions": {
        "defaultMode": "plan",
        "ask": [
            "Bash(git branch*)",
            "Bash(git checkout*)",
            "Bash(git commit*)",
            "Edit(/**)",
            "Write(/**)"
        ],
        "allow": [
            "Agent(Explore)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git remote get-url *)",
            "Bash(git status)",
            "Bash(git switch -c *)",
            "Bash(head *)",
            "Bash(ls *)",
            "Bash(tail *)",
            "Bash(wc *)",
            "Glob(/**)",
            "Grep(/**)",
            "Read(/**)",
            "Search",
            "TodoWrite"
        ]
    },
    "sandbox": {
        "enabled": true,
        "autoAllowBashIfSandboxed": false
    },
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"Before responding, assess if documentation (project docs, company wiki, your KB, user KB) might need updating based on this task. If so, use TodoWrite to create a doc-update task with a short mnemonic (e.g. 'IAM gotcha in ECS → KB + wiki'). Skip if no documentation would benefit or you already have an item for the same topic.\"}}'"
                    }
                ]
            }
        ]
    }
}
