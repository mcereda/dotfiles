{
    "minimumVersion": "2.1.81",
    "autoUpdatesChannel": "stable",

    "outputStyle": "Explanatory",
    "autoDreamEnabled": true,
    "voiceEnabled": true,

    "model": "opusplan",
    "alwaysThinkingEnabled": true,
    "effortLevel": "high",

    "env": {
        "DISABLE_TELEMETRY": "1"
    },
    "enabledPlugins": {
        "skill-creator@claude-plugins-official": true
    },
    "disabledMcpServers": [
        "claude-in-chrome"
    ],

    "permissions": {
        "defaultMode": "plan",
        "ask": [
            "Bash(git branch*)",
            "Bash(git checkout*)",
            "Bash(git commit*)",
            "Edit(/**)",
            "Write(/**)"
        ],
        "allow": [
            "Agent(Explore)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git remote get-url *)",
            "Bash(git status)",
            "Bash(git switch -c *)",
            "Bash(head *)",
            "Bash(ls *)",
            "Bash(tail *)",
            "Bash(wc *)",
            "Glob(/**)",
            "Grep(/**)",
            "Read(/**)",
            "Search",
            "TodoWrite"
        ]
    },
    "sandbox": {
        "enabled": true,
        "autoAllowBashIfSandboxed": false
    },
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"Before writing your response, call TodoWrite to add this task: Update docs (project, wikis, KBs), if needed, before committing. Skip if it is already in your task list.\"}}'"
                    }
                ]
            }
        ]
    }
}
