{
    "minimumVersion": "2.1.193",
    "autoUpdatesChannel": "stable",

    "tui": "fullscreen",
    "verbose": true,
    "autoDreamEnabled": true,
    "voiceEnabled": true,
    
    "model": "claude-opus-4-6",
    "alwaysThinkingEnabled": true,
    "outputStyle": "Explanatory",

    "env": {
        "CLAUDE_CODE_EFFORT_LEVEL": "xhigh",
        "CLAUDE_EXPLORATION_DIR": "{{ .chezmoi.homeDir }}/Repositories/claude/exploration",
        "DISABLE_TELEMETRY": "1"
    },
    "enabledPlugins": {
        "skill-creator@claude-plugins-official": true
    },
    "disabledMcpServers": [
        "claude-in-chrome"
    ],
    "skillOverrides": {
        "explore-repos": "name-only",
        "rule-writing": "name-only",
        "skill-authoring": "name-only",
        "subagent-dispatch": "name-only",
        "update-from-source": "name-only",
        "version-control": "name-only"
    },

    "permissions": {
        "defaultMode": "plan",
        "additionalDirectories": [
            "~/Repositories/claude/exploration"
        ],
        "deny": [
            "Bash(git -C {{ .chezmoi.homeDir }}/Repositories/claude/exploration/* commit *)",
            "Bash(git -C {{ .chezmoi.homeDir }}/Repositories/claude/exploration/* push *)"
        ],
        "ask": [
            "Edit(/**)",
            "Write(/**)"
        ],
        "allow": [
            "Agent(Explore)",
            "Bash(git config user.*)",
            "Bash(git config --global user.*)",
            "Bash(git config --local user.*)",
            "Bash(git -C * config --global user.*)",
            "Bash(git -C * config --local user.*)",
            "Bash(git diff)",
            "Bash(git diff *)",
            "Bash(git -C * diff)",
            "Bash(git -C * diff *)",
            "Bash(git log)",
            "Bash(git log *)",
            "Bash(git -C * log)",
            "Bash(git -C * log *)",
            "Bash(git remote get-url *)",
            "Bash(git show *)",
            "Bash(git status)",
            "Bash(git status *)",
            "Bash(git -C * status)",
            "Bash(git -C * status *)",
            "Bash(git switch -c *)",
            "Bash(git worktree list)",
            "Bash(grep *)",
            "Bash(head *)",
            "Bash(ls *)",
            "Bash(tail *)",
            "Bash(wc *)",
            "Read(/**)",
            "Search",
            "TaskCreate",
            "TaskUpdate",

            "Bash(git -C {{ .chezmoi.homeDir }}/Repositories/claude/exploration/* *)"
        ]
    },
    "sandbox": {
        "enabled": true,
        "autoAllowBashIfSandboxed": false
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "TaskUpdate",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -c 'if .tool_input.status == \"completed\" then {\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"Task marked complete. Stop and report what you did and what you would do next. Do not start the next task.\"}} else empty end'"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"Before responding, assess if documentation (project docs, company wiki, your KB, user KB) might need updating based on this task or insights from previous work. If so, use TaskCreate + TaskUpdate to track doc-update tasks with a short mnemonic (e.g. IAM gotcha in ECS → KB + wiki) immediately. Delegate to a background agent if available (e.g. kb-contributor). Skip if no documentation would benefit or you already have an item for the same topic. If you skipped a save this session because it felt too small or premature, reassess: is it re-derivable? If not, file it now.\"}}'"
                    }
                ]
            }
        ]
    }
}
