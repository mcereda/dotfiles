################################################################################
## ~/.tool-versions
##
## Only versions or "system" are supported here, not "latest".
## Put the version to use as default first, followed by all fallback versions
## in order.
##
## Sources:
## - https://asdf-vm.com/manage/configuration.html#tool-versions
################################################################################

{{- /* Check the commented content of the result of `chezmoi diff` */}}
{{-    $debug := false }}

{{- /*
     * Compute or set default values for this file. Add yours here.
     * I just find nice to have them handy here and reference them later, and
     * setting them one per line feels more readable than a convoluted,
     * all-in-one dict definition (I tried).
     */}}

{{-    $defaults := dict }}
{{-    $_ := set $defaults "data" dict }}

{{-    if $debug }}
{{       "defaults:" | comment "# " }}
{{       $defaults | toYaml | indent 4 | comment "# " }}
{{-    end }}

{{- /*
     * Start from the defaults and overwrite them with the existing
     * configuration from the configuration file.
     */}}

{{-    $config := $defaults }}

{{-    $configFromFile := include $.chezmoi.configFile | fromYaml }}
{{-    $_ := mustMergeOverwrite $config $configFromFile }}

{{-    if $debug }}
{{       "merged with config file" | comment "# " }}
{{       "config:" | comment "# " }}
{{       $config | toYaml | indent 4 | comment "# " }}
{{-    end }}


{{-    $hostFiles := list
         (joinPath $config.data.hostDir ".tool-versions.tmpl")
         (joinPath $config.data.hostDir ".tool-versions") }}
{{-    $hostEncryptedFiles := list
         (joinPath $config.data.encryptedHostDir (print ".tool-versions.tmpl" (dig "age" "suffix" ".age" $config)))
         (joinPath $config.data.encryptedHostDir (print ".tool-versions.tmpl" (dig "gpg" "suffix" ".asc" $config)))
         (joinPath $config.data.encryptedHostDir (print ".tool-versions" (dig "age" "suffix" ".age" $config)))
         (joinPath $config.data.encryptedHostDir (print ".tool-versions" (dig "gpg" "suffix" ".asc" $config))) }}
{{-    includeTemplate "_host-overlay_plaintext.tmpl" (dict
         "chezmoi" $.chezmoi
         "config" $config
         "hostPlainFiles" $hostFiles
         "hostEncryptedFiles" $hostEncryptedFiles
         "debug" $debug
       ) }}
