{{- /* Check the commented content of the result of `chezmoi diff` */}}
{{-    $debug := false }}

{{- /*
     * Compute or set default values for this file. Add yours here.
     * I just find nice to have them handy here and reference them later, and
     * setting them one per line feels more readable than a convoluted,
     * all-in-one dict definition (I tried).
     */}}

{{-    $defaults := dict }}
{{-    $_ := set $defaults "data" dict }}

{{-    if $debug }}
{{       "defaults:" | comment "# " }}
{{       $defaults | toYaml | indent 4 | comment "# " }}
{{-    end }}

{{- /*
     * Start from the defaults and overwrite them with the existing
     * configuration from the configuration file.
     */}}

{{-    $config := $defaults }}

{{-    $configFromFile := include $.chezmoi.configFile | fromYaml }}
{{-    $_ := mustMergeOverwrite $config $configFromFile }}

{{-    if $debug }}
{{       "merged with config file" | comment "# " }}
{{       "config:" | comment "# " }}
{{       $config | toYaml | indent 4 | comment "# " }}
{{-    end -}}


alias aws-caller-info 'aws sts get-caller-identity'
alias aws-ec2-running-instanceIds "aws ec2 describe-instances --output 'text' \
	--filters 'Name=instance-state-name,Values=running' \
	--query 'Reservations[].Instances[0].InstanceId' \
| sed -E 's/\t+/\n/g'"
alias aws-env "set | grep 'AWS_' | grep -v 'history'"
alias aws-ssm 'aws ssm start-session --target'
alias aws-whoami 'aws-caller-info'


{{-    $hostFiles := list
         (joinPath $config.data.hostDir ".config" "fish" "conf.d" "awscli.fish.tmpl")
         (joinPath $config.data.hostDir ".config" "fish" "conf.d" "awscli.fish") }}
{{-    $hostEncryptedFiles := list
         (joinPath $config.data.encryptedHostDir ".config" "fish" "conf.d" (print "awscli.fish.tmpl" (dig "age" "suffix" ".age" $config)))
         (joinPath $config.data.encryptedHostDir ".config" "fish" "conf.d" (print "awscli.fish.tmpl" (dig "gpg" "suffix" ".asc" $config)))
         (joinPath $config.data.encryptedHostDir ".config" "fish" "conf.d" (print "awscli.fish" (dig "age" "suffix" ".age" $config)))
         (joinPath $config.data.encryptedHostDir ".config" "fish" "conf.d" (print "awscli.fish" (dig "gpg" "suffix" ".asc" $config))) }}
{{-    includeTemplate "_host-overlay_plaintext.tmpl" (dict
         "chezmoi" $.chezmoi
         "config" $config
         "hostPlainFiles" $hostFiles
         "hostEncryptedFiles" $hostEncryptedFiles
         "debug" $debug
       ) }}
