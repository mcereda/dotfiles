################################################################################
## .chezmoiignore
################################################################################

# Files specific to this repository.
LICENSE
README.md
TODO.md


{{- /*
     * Ignore files specific to the host's OS.
     */}}


{{-    if ne .chezmoi.os "darwin" }}

# Ignore Darwin-specific application configurations.
Library/
.config/fish/**/osx.*

{{-    end }}

{{-    if ne .chezmoi.os "linux" }}

# Ignore Linux-specific applications configurations.
.config/fish/**/linux.*

{{-    end }}

{{-    if ne .chezmoi.os "windows" }}

# Ignore Windows-specific applications configurations.
.config/git/config.windows.inc

{{-    end }}


{{- /*
     * Ignore files for applications absent from the host.
     */}}


{{-    if not (lookPath "ansible") }}

# Ansible not found in the user's PATH, ignore all the related files.
.ansible.cfg
.config/fish/**/*ansible*

{{-    end }}


{{-    if not (lookPath "asdf") }}

# Asdf not found in the user's PATH, ignore all the related files.
.tool-versions
.config/fish/**/*asdf*

{{-    end }}


{{-    if not (lookPath "aws") }}

# AWS CLI not found in the user's PATH, ignore all the related files.
.aws/
.config/fish/**/*aws*

{{-    end }}


{{-    if not (lookPath "az") }}

# Azure CLI not found in the user's PATH, ignore all the related files.
.azure/

{{-    end }}


{{-    if not (lookPath "bash") }}

# Bash not found in the user's PATH, ignore all the related files.
.bash_*
.bashrc
.inputrc

{{-    end }}


{{-    if not (lookPath "brew") }}

# Homebrew not found in the user's PATH, ignore all the related files.
.config/homebrew/
.homebrew/
.Brewfile
.config/fish/**/*brew*

{{-    end }}


{{-    if not (lookPath "claude") }}

# Claude Code not found in the user's PATH, ignore all the related files.
.claude/

{{-    end }}


{{-    if or
         (eq (lookPath "code") "")
         (eq (lookPath "code-oss") "")
       }}

# Visual Studio Code not found in the user's PATH, ignore all its files.
.config/Code/
.config/Code - OSS/
.vscode/
.vscode-oss/
{{-      if eq .chezmoi.os "darwin" }}
Library/Application Support/Code/
Library/Application Support/Code - OSS/
{{-      end }}
{{-    end }}


{{-    if not (lookPath "dblab") }}

# DBLab CLI not found in the user's PATH, ignore all the related files.
.config/fish/**/*dblab*

{{-    end }}


{{-    if not (lookPath "fish") }}

# Fish not found in the user's PATH, ignore all the related files.
.config/fish/
.local/share/fish/

{{-    end }}


{{-    if not (lookPath "git") }}

# Git not found in the user's PATH, ignore all the related files.
.config/git/
.gitconfig
.config/fish/**/*git*

{{-    end }}


{{-    if not (lookPath "gpg") }}

# GnuPG not found in the user's PATH, ignore all the related files.
.gnupg/
.config/fish/**/*gpg*

{{-    end }}


{{-    if not (lookPath "keybase") }}

# Keybase not found in the user's PATH, ignore all the related files.
.config/fish/**/*keybase*

{{-    end }}


{{-    if not (lookPath "kubectl") }}

# Kubectl not found in the user's PATH, ignore all related files.
.config/fish/**/*kubectl*

{{-    end }}


{{-    if not (lookPath "mas") }}

# Mas not found in the user's PATH, ignore all related files.
.config/fish/**/*mas*

{{-    end }}


{{-    if not (lookPath "opencode") }}

# OpenCode not found in the user's PATH, ignore all related files.
.config/opencode/

{{-    end }}


{{-    if not (lookPath "pip") }}

# Pip not found in the user's PATH, ignore all the related files.
.config/pip/
.pip/

{{-    end }}


{{-    if not (lookPath "pipx") }}

# Pipx not found in the user's PATH, ignore all the related files.
.local/pipx

{{-    end }}


{{-    if not (lookPath "psql") }}

# psql not found in the user's PATH, ignore all the related files.
.pgpass
.pg_service.conf
.config/fish/**/*postgresql*

{{-    end }}


{{-    if not (lookPath "pulumi") }}

# Pulumi not found in the user's PATH, ignore all related files.
.config/fish/**/*pulumi*

{{-    end }}


{{-    if not (lookPath "screen") }}

# Screen not found in the user's PATH, ignore all the related files.
.screenrc

{{-    end }}


{{-    if not (lookPath "snow") }}

# Snowflake CLI not found in the user's PATH, ignore all the related files.
.config/fish/**/*snowflake*

{{-    end }}


{{-    if not (lookPath "starship") }}

# Starship not found in the user's PATH, ignore all the related files.
.config/starship.toml
.config/fish/**/*starship*

{{-    end }}


{{-    if not (lookPath "tmux") }}

# Tmux not found in the user's PATH, ignore all the related files.
.config/tmux/
.tmux.conf

{{-    end }}


{{-    if and
         (not (lookPath "vim"))
         (not (lookPath "vim.tiny")) }}

# Vim not found in the user's PATH, ignore all the related files.
.vimrc

{{-    end }}


{{-    if not (lookPath "zsh") }}

# Zsh not found in the user's PATH, ignore all the related files.
.zshenv
.zshrc
.zprofile

{{-    end }}
